<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restore from the local ./feed first; nuget.org is only a fallback for the .NET host/apphost packs.
    Paths are relative to this file's directory (the example root, copied to /src in the image).
  -->
  <packageSources>
    <clear />
    <add key="local-ladybug" value="./feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
