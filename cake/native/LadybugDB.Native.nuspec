<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/01/nuspec.xsd">
  <metadata>

    <!-- package (version/commit are substituted at pack time) -->
    <id>LadybugDB.Native</id>
    <title>LadybugDB native engine (all platforms)</title>
    <version>$version$</version>
    <description>Native Ladybug engine libraries for all supported platforms. Companion to the managed LadybugDB package: reference both LadybugDB and LadybugDB.Native to run on any supported platform, or reference a single LadybugDB.Native.&lt;rid&gt; package for a slim, platform-specific app.</description>
    <summary>Native Ladybug engine binaries for all supported platforms.</summary>
    <projectUrl>https://github.com/ladybugdb/ladybug</projectUrl>
    <repository type="git" url="https://github.com/LadybugDB/ladybug-dotnet" commit="$commit$" />
    <tags>graph graph-database database cypher embedded ladybug native</tags>

    <!-- legal -->
    <license type="expression">MIT</license>
    <authors>LadybugDB</authors>
    <owners>LadybugDB</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <copyright>Copyright (c) LadybugDB</copyright>

    <!-- pulls in the per-RID native packages -->
    <dependencies>
      <group targetFramework="netstandard2.0">
        <dependency id="LadybugDB.Native.win-x64" version="$version$" include="native" />
        <dependency id="LadybugDB.Native.linux-x64" version="$version$" include="native" />
        <dependency id="LadybugDB.Native.linux-arm64" version="$version$" include="native" />
        <dependency id="LadybugDB.Native.osx-x64" version="$version$" include="native" />
        <dependency id="LadybugDB.Native.osx-arm64" version="$version$" include="native" />
      </group>
    </dependencies>

  </metadata>
  <files>

    <!-- Empty lib marker so NuGet adds no compile-time reference when this package is consumed. -->
    <file src="_._" target="lib/netstandard2.0/_._" />

  </files>
</package>
