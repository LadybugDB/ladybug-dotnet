<Project>

  <!-- NuGet package metadata + native runtime packing. Imported by the packable project. -->
  <PropertyGroup>
    <!-- Single source of truth: version.txt at the binding root (e.g. 0.17.0.1). The cake/
         pipeline reads the same file; this default only applies to a direct `dotnet pack`. -->
    <Version Condition="'$(Version)' == ''">$([System.IO.File]::ReadAllText('$(CSharpDir)version.txt').Trim())</Version>
    <Authors>LadybugDB</Authors>
    <Company>LadybugDB</Company>
    <Product>Ladybug</Product>
    <PackageId>LadybugDB</PackageId>
    <Title>LadybugDB - embedded graph database</Title>
    <Description>Official C# binding for the Ladybug embedded graph database (Cypher). Wraps the native Ladybug C API via P/Invoke and ships prebuilt native libraries for supported platforms.</Description>
    <PackageTags>graph;graph-database;database;cypher;embedded;ladybug;olap;analytics</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ladybugdb/ladybug</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LadybugDB/ladybug-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(CSharpDir)README.md" Pack="true" PackagePath="\" Condition="Exists('$(CSharpDir)README.md')" />
  </ItemGroup>

  <!--
    This package is managed-only. The native engine ships separately in the LadybugDB.Native.<rid>
    packages (and the LadybugDB.Native meta-package); consumers reference LadybugDB plus a native
    package. See cake/ for the packaging pipeline.
  -->

</Project>
