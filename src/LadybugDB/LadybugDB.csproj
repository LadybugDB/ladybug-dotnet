<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <AssemblyName>LadybugDB</AssemblyName>
    <RootNamespace>LadybugDB</RootNamespace>
    <DebugType>portable</DebugType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LadybugDB.Tests" />
  </ItemGroup>

  <Import Project="$(CSharpDir)nuget\nuget-package.props" />

</Project>
